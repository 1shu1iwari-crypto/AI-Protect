<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application>
        <activity android:name=".LiveReviewActivity" android:exported="false" />
        <service android:name=".LiveReviewService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".ReviewAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/review_accessibility_service" />
        </service>
    </application>
</manifest>
